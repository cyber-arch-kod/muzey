# SUPABASE_URL: Required for Supabase Postgres and Storage backend (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Required public anon key from your Supabase project settings
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# MAPS_API_KEY: Required Google Maps SDK for Android API key
MAPS_API_KEY=YOUR_MAPS_API_KEY

# SHARE_BASE_URL: Public web origin for /m/[slug] share links
SHARE_BASE_URL=https://muzeycha.uz

# TELEGRAM_BOT_USERNAME: Telegram bot username (without @) for t.me/<bot>?startapp=<slug> Mini App links
TELEGRAM_BOT_USERNAME=muzeycha_uz_bot
